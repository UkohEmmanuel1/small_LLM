# Copy to .env.product and replace every placeholder. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=smallllm
POSTGRES_USER=smallllm
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
REDIS_URL=redis://redis:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3000
MAX_OUTPUT_TOKENS=1024
ANON_RATE=5/min
USER_RATE=30/min
INFERENCE_RATE=10/min

API_KEY_MANAGEMENT_RATE=20/hour
MAX_PROMPT_CHARS=24000
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
