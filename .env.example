# Hugging Face User Access Token with Inference permissions
HF_TOKEN=hf_your_token_here

# Comma-separated API keys issued to developers. Keep this secret.
API_KEYS=sk-small- replace-this-with-a-long-random-secret

# Optional model override. :cheapest asks Hugging Face to select a lower-cost provider.
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct:cheapest
MAX_OUTPUT_TOKENS=512
DEMO_REQUESTS_PER_MINUTE=8
